{
  "compilerOptions": {
    "target": "ES2023",
    // DOM as well as node: `scripts/replay-check.ts` imports the app's own modules, and
    // those are browser code — `lib/api.ts` alone reaches for it. The script itself uses
    // nothing from either beyond `console` and `performance`.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["scripts"]
}
