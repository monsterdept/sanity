{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sanity",
  "version": "0.1.0",
  "identifier": "monster.sanity",
  "build": {
    "beforeDevCommand": "cd web && npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "cd web && npm run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Sanity desktop",
    "longDescription": "Sanity \u2014 see where the thinking in your codebase actually is"
  }
}
